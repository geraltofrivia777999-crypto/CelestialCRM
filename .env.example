ENVIRONMENT=development
APP_PORT=8080
SECRET_KEY=change-me-to-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=
POSTGRES_DB=celestial
POSTGRES_USER=celestial
POSTGRES_PASSWORD=change-me-to-a-random-database-password
DATABASE_URL=postgresql+asyncpg://celestial:change-me-to-a-random-database-password@postgres:5432/celestial
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
DEFAULT_TIMEZONE=Asia/Qyzylorda
DEFAULT_CURRENCY=USD
KEITARO_SYNC_ENABLED=false
KEITARO_SYNC_INTERVAL_MINUTES=15
# Группа офферов в Keitaro, которую показывает модуль «Оффера»
KEITARO_OFFERS_GROUP=OFFERS
# Файлы базы знаний: 20 МБ на файл, 2 ГБ на воркспейс, 24 часа на привязку к статье.
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_WORKSPACE_QUOTA_BYTES=2147483648
UPLOAD_UNBOUND_TTL_HOURS=24
META_SYNC_ENABLED=false
META_SYNC_INTERVAL_MINUTES=30
# Автоправила выполняют действия в кабинете (пауза, бюджет) — включать отдельно
# и только после проверки правил кнопкой «Что сработает».
META_RULES_ENABLED=false
META_RULES_INTERVAL_MINUTES=30
META_API_BASE=https://graph.facebook.com
# Версия Graph API. Meta выпускает новую примерно раз в квартал и снимает
# поддержку старой через два года — поднимать здесь перед истечением срока.
META_GRAPH_VERSION=v23.0
# Браузер для подключений «Токен сессии (EAAB)». Токен берётся из живого
# браузера с cookies и прокси аккаунта; при капче/чекпойнте вход выполняется
# вручную через VNC (порт 5900).
META_SESSION_ENABLED=true
# "chrome" = установленный Chrome (лучше для антидетекта), "" = Chromium
# Playwright. В Docker оставьте пустым — Chrome в образе нет, и канал
# откатится на Chromium сам.
META_BROWSER_CHANNEL=
META_BROWSER_HEADLESS=false
META_BROWSER_VIEWPORT_WIDTH=1366
META_BROWSER_VIEWPORT_HEIGHT=768
META_BROWSER_LOCALE=ru-RU
META_BROWSER_TIMEZONE=Europe/Moscow
# Сколько ждать ручной вход (капча/чекпойнт), секунды
META_LOGIN_TIMEOUT_SEC=900
# Сохранённые браузерные сессии: по ним синхронизация обновляет умерший EAAB
META_SESSION_DIR=/app/meta_sessions
META_SESSION_TTL_HOURS=72
# Уведомления «Утилит» пишут в общий чат команды — включать после того, как
# правила проверены кнопкой «Что сейчас».
ALERTS_ENABLED=false
ALERTS_INTERVAL_MINUTES=5
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now
